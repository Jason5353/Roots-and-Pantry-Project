---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/caveat/700.css';
import '../styles/site.css';
import { site } from '../data/site.js';

interface Props { title?: string; description?: string; active?: string }
const {
  title,
  description = 'Free forever: your family recipes in one private place, with exclusive deals from independent local food producers.',
  active = '',
} = Astro.props;
const fullTitle = title ? `${title} | Roots & Pantry` : 'Roots & Pantry: family recipes and local food deals';
// Stays noindex until launch day. Set PUBLIC_INDEX=yes in Cloudflare (production only) to let search engines in.
const indexable = import.meta.env.PUBLIC_INDEX === 'yes';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['/how-it-works/', 'How it works', 'how'],
  [`${site.app}/producers`, 'Find producers', 'find'],
  ['/for-producers/', 'For producers', 'producers'],
  ['/about/', 'About', 'about'],
  ['/faq/', 'FAQ', 'faq'],
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {indexable ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#1E2A4A" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/img/og.jpg', Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site">
    <div class="wrap">
      <a href="/" class="logo">
        <span class="mark" aria-hidden="true">R&amp;P</span>
        <span class="word">Roots <span class="amp">&amp;</span> Pantry</span>
      </a>
      <nav class="main" aria-label="Main">
        {nav.map(([href, label, key]) => (
          <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <a class="btn btn-red head-cta" href="/#start">Get started</a>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Main (mobile)">
          {nav.map(([href, label, key]) => (
            <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>
          ))}
          <a href="/contact/">Contact</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <div class="fcol">
        <p class="fname">Roots &amp; Pantry</p>
        <p>Family recipes and local food deals. Free forever.</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><a href={site.facebook} rel="noopener">Roots &amp; Pantry on Facebook</a></p>
      </div>
      <nav class="fcol" aria-label="Footer">
        <a href="/how-it-works/">How it works</a>
        <a href={`${site.app}/producers`}>Find producers</a>
        <a href="/for-producers/">For producers</a>
        <a href="/about/">About</a>
        <a href="/faq/">FAQ</a>
        <a href="/press/">Press</a>
        <a href="/contact/">Contact</a>
        <a href="/accessibility/">Accessibility</a>
        <a href="/privacy-and-terms/">Privacy &amp; terms</a>
        <a href="/producer-terms/">Producer terms</a>
      </nav>
      <div class="fcol small">
        <p>Roots &amp; Pantry is a trading name of <a href={site.companyUrl}>{site.company}</a>, registered in England and Wales, company number {site.companyNumber}.</p>
        <p>No advertising trackers. Photos on the home and producer pages are AI-generated illustrations; the About page shows our own family photos.</p>
        <p>© {year} {site.company}</p>
      </div>
    </div>
  </footer>
</body>
</html>
