---
import Layout from '../layouts/Layout.astro';
import { mail } from '../data/site.js';
const counties = [
  ['Shropshire', 'Signing up now'],
  ['Staffordshire', 'Coming soon'],
  ['Cheshire', 'Coming soon'],
  ['Herefordshire', 'Coming soon'],
  ['Worcestershire', 'Coming soon'],
  ['Powys', 'Coming soon'],
];
---
<Layout title="Local producers" active="local" description="Independent food producers on Roots & Pantry, by county. Starting in Shropshire.">
  <div class="wrap pagehead">
    <h1>Local producers</h1>
    <p class="sub">Independent farms, makers, market stalls and shops that offer Roots &amp; Pantry families an exclusive deal. Starting in Shropshire.</p>
  </div>
  <div class="wrap prose">
    <div class="callout green">
      <p><b>The directory opens soon.</b> We're signing up Shropshire producers now, so there's a full list when families join.</p>
    </div>
    <h2>Counties</h2>
    <ul class="counties">
      {counties.map(([name, status], i) => <li class={i === 0 ? 'live' : ''}>{name}: {status}</li>)}
    </ul>
    <p>Anywhere in the UK can join. If your county isn't listed yet, you can still sign up.</p>
    <h2>Know a great local producer?</h2>
    <p>Tell us who they are and we'll get in touch with them.</p>
    <p><a class="btn btn-ghost" href={mail('Nominate a producer')}>Nominate a producer</a></p>
    <h2>Are you a producer?</h2>
    <p><a class="btn btn-green" href="/for-producers/">List your business free</a></p>
  </div>
</Layout>
