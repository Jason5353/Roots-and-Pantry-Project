---
import Layout from '../layouts/Layout.astro';
import { site, mail, contact } from '../data/site.js';
---
<Layout title="Press" description="Facts and contacts for journalists writing about Roots & Pantry.">
  <div class="wrap pagehead">
    <h1>Press</h1>
    <p class="sub">Writing about Roots &amp; Pantry? Here are the key facts.</p>
  </div>
  <div class="wrap prose">
    <h2>In one sentence</h2>
    <p>Roots &amp; Pantry is a free family recipe app, built in Telford, that shows families exclusive deals from independent local food producers instead of supermarkets.</p>
    <h2>Key facts</h2>
    <table class="simple">
      <tbody>
        <tr><th scope="row">Launch</th><td>Producers joining now in Shropshire; family sign-up opens soon</td></tr>
        <tr><th scope="row">Price</th><td>Free forever for families; free basic listing for producers</td></tr>
        <tr><th scope="row">Where</th><td>UK-wide, starting in Shropshire</td></tr>
        <tr><th scope="row">Founder</th><td>Jason Lewis, Wellington, Telford</td></tr>
        <tr><th scope="row">Company</th><td>A trading name of {site.company}</td></tr>
        <tr><th scope="row">Website</th><td>rootsandpantry.co.uk</td></tr>
      </tbody>
    </table>
    <h2>What makes it different</h2>
    <ul>
      <li>It promotes independent local producers, not supermarkets or big brands.</li>
      <li>It's free for families and producers, with no advertising trackers.</li>
      <li>It's designed for every age, including children, older people, and disabled and neurodivergent users.</li>
    </ul>
    <h2>Logo and images</h2>
    <p>Our logo and screenshots will be available here soon. Ask us for them in the meantime.</p>
    <h2>Contact</h2>
    <p><a href={contact('Press')}>Send us a message</a> or email <b>{site.email}</b>.</p>
  </div>
</Layout>
