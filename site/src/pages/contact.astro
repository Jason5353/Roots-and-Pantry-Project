---
import Layout from '../layouts/Layout.astro';
import { site, mail, contact } from '../data/site.js';
---
<Layout title="Contact" description="Get in touch with Roots & Pantry.">
  <div class="wrap pagehead">
    <h1>Contact us</h1>
    <p class="sub">Questions, ideas, producer enquiries or press: one inbox, and a real person reads it.</p>
  </div>
  <div class="wrap prose">
    <p class="hand">Say hello</p>
    <p><a class="btn btn-red" href={`${site.app}/contact`}>Use our contact form</a></p>
    <p>Or email <a href={`mailto:${site.email}`}>{site.email}</a>. We aim to reply within 5 working days.</p>
    <h2>Quick links</h2>
    <ul>
      <li><a href={`${site.app}/signin?next=/producer/join`}>List my food business</a></li>
      <li><a href={contact('Nominate a producer')}>Nominate a local producer</a></li>
      <li><a href={contact('Press')}>Press enquiry</a></li>
      <li><a href={contact('Report a problem')}>Report a problem or a broken deal</a></li>
    </ul>
    <p>For our company details, see <a href="/privacy-and-terms/">Privacy &amp; terms</a>.</p>
  </div>
</Layout>
