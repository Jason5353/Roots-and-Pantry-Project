// Roots & Pantry app. Top level = production (app.rootsandpantry.co.uk, branch main).
// `env.test` = test copy (test-app.rootsandpantry.co.uk, branch test) with its own database.
// Secrets (set in the Cloudflare dashboard, never in this file):
//   TURNSTILE_SECRET, BREVO_API_KEY, CODE_PEPPER
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rp-app",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [{ "pattern": "app.rootsandpantry.co.uk", "custom_domain": true }],
  "vars": {
    "APP_NAME": "Roots & Pantry",
    "SITE_URL": "https://rootsandpantry.co.uk",
    "NOTIFY_EMAIL": "hello@rootsandpantry.co.uk",
    "FROM_EMAIL": "hello@rootsandpantry.co.uk",
    "OWNER_EMAIL": "hello@rootsandpantry.co.uk",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGBL884bbg2kowkP",
    "PRODUCER_SIGNUP_OPEN": "true",
    "ENV_LABEL": ""
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "rp-app", "database_id": "a6f83336-a185-49a9-a128-5ab2efa37460", "migrations_dir": "migrations" }
  ],
  "env": {
    "test": {
      "name": "rp-app-test",
      "routes": [{ "pattern": "test-app.rootsandpantry.co.uk", "custom_domain": true }],
      "vars": {
        "APP_NAME": "Roots & Pantry",
        "SITE_URL": "https://test.roots-and-pantry-project.pages.dev",
        "NOTIFY_EMAIL": "hello@rootsandpantry.co.uk",
        "FROM_EMAIL": "hello@rootsandpantry.co.uk",
        "OWNER_EMAIL": "hello@rootsandpantry.co.uk",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAGBL884bbg2kowkP",
        "PRODUCER_SIGNUP_OPEN": "true",
        "ENV_LABEL": "TEST"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "rp-app-test", "database_id": "b5d8ac37-fc15-43d8-95b1-06ea2de71389", "migrations_dir": "migrations" }
      ]
    }
  }
}
